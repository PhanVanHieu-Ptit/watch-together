# Node.js reads .env through npm start / npm run dev:backend.
PORT=3001
RECONNECT_GRACE_MS=30000
SKIP_VOTE_MS=30000
SKIP_VOTE_RATIO=0.6
EMPTY_ROOM_MS=1800000
ROOM_TTL_MS=86400000

# Local account store (passwords are salted scrypt hashes). Keep data/ out of version control.
ACCOUNTS_FILE=data/accounts.json

# Time to vote before the first queued video starts in an empty authenticated room.
NEXT_VIDEO_DELAY_MS=20000

# Durable private room definitions, ownership, password hashes and saved playlists.
ROOMS_FILE=data/rooms.json
