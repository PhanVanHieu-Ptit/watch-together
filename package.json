{
  "name": "cung-xem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js",
    "typecheck": "tsc --noEmit",
    "dev:frontend": "vite --host 0.0.0.0 --port 5178",
    "dev:backend": "node --env-file-if-exists=.env --watch server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "~5.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/node": "^24.0.0"
  }
}
